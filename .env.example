# Copy to .env (`make up` does this if .env is missing). Placeholder values: change them.
# Use letters, digits and hyphens only in passwords (they are embedded in connection URLs).

# Postgres: one instance hosting source, iceberg_catalog, serving and airflow databases
POSTGRES_USER=ledgerlake
POSTGRES_PASSWORD=change-me-postgres

# MongoDB root user
MONGO_ROOT_USER=ledgerlake
MONGO_ROOT_PASSWORD=change-me-mongo

# MinIO root user (also used as the S3 access key by Spark). Password: at least 8 characters.
MINIO_ROOT_USER=ledgerlake
MINIO_ROOT_PASSWORD=change-me-minio

# Salt for hashing email and phone in silver (used from D2-AM)
PII_SALT=change-me-salt

# Login passwords for the serving database roles (set by the publish job)
ANALYST_PASSWORD=change-me-analyst
ENGINEER_PASSWORD=change-me-engineer

# Spark driver memory inside the Airflow container
SPARK_DRIVER_MEMORY=2g

# Host ports (bound to 127.0.0.1). Change if something else already uses them.
POSTGRES_PORT=5432
MONGO_PORT=27017
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
AIRFLOW_PORT=8080
